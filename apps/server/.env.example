PORT=1234
# Defaults to a local file (no external account needed) if unset. Point at
# a hosted Turso database instead with DATABASE_URL=libsql://... plus
# DATABASE_AUTH_TOKEN -- see the root README's "Live" section for why.
DATABASE_URL=file:./data/tandem.sqlite
# DATABASE_AUTH_TOKEN=
MAX_ROOM_BYTES=5242880
